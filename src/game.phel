(ns connect4.game
  (:require connect4.board :refer [make-board drop-token winner? board-full? other-player]))

(defstruct TGame [board player history status winner prev])

(defn make-game
  "Fresh game; Red moves first."
  []
  (TGame (make-board) :red [] :playing nil nil))

(defn game-over? [game]
  (not= :playing (get game :status)))

(defn step
  "Apply a move in `col`. Invalid or full column returns the game unchanged."
  [game col]
  (if (game-over? game)
    game
    (let [result (drop-token (get game :board) col (get game :player))]
      (if (nil? result)
        game
        (let [[board row] result
              p           (get game :player)
              won?        (winner? board row col p)
              status      (cond won?                :won
                                (board-full? board) :draw
                                :else               :playing)]
          (TGame board
                 (if won? p (other-player p))
                 (conj (get game :history) [p col])
                 status
                 (if won? p nil)
                 game))))))

(defn undo
  "Return the game state before the last move; a no-op on a fresh game."
  [game]
  (or (get game :prev) game))
