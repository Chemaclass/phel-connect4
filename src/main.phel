(ns connect4\main
  (:require connect4\board :as b)
  (:require connect4\game :as g)
  (:require connect4\render :as r)
  (:require connect4\ai :as ai))

(def stdin (php/fopen "php://stdin" "r"))

(def difficulties
  [{:key "1" :name "easy"   :depth 2}
   {:key "2" :name "medium" :depth 4}
   {:key "3" :name "hard"   :depth 6}
   {:key "4" :name "expert" :depth 7}])

(def default-difficulty "medium")

(defn- read-input []
  (let [line (php/fgets stdin)]
    (when (not= false line)
      (php/trim line))))

(defn- difficulty-by [pred]
  (first (filter pred difficulties)))

(defn- difficulty-from-env []
  (let [name-env  (php/getenv "DIFFICULTY")
        depth-env (php/getenv "AI_DEPTH")]
    (cond
      (not= false depth-env)
      {:name (str "custom depth " (php/intval depth-env))
       :depth (php/intval depth-env)}

      (not= false name-env)
      (difficulty-by #(= (get % :name) (php/strtolower name-env)))

      :else                  nil)))

(defn- prompt-difficulty []
  (println "=== Connect 4 ===")
  (println "Choose AI difficulty:")
  (doseq [d difficulties]
         (println (str "  " (get d :key) ") " (get d :name)
                       " (depth " (get d :depth) ")")))
  (print (str "Difficulty [1-4, default=" default-difficulty "]: "))
  (php/flush)
  (let [input (read-input)
        pick  (cond
                (or (nil? input) (= input ""))
                (difficulty-by #(= (get % :name) default-difficulty))

                :else
                (or (difficulty-by #(= (get % :key) input))
                    (difficulty-by #(= (get % :name) (php/strtolower input)))))]
    (or pick (difficulty-by #(= (get % :name) default-difficulty)))))

(def ai-player
  (case (php/getenv "AI")
    "red"    :red
    "yellow" :yellow
    nil))

(def difficulty
  (when ai-player
    (or (difficulty-from-env) (prompt-difficulty))))

(def ai-depth
  (if difficulty (get difficulty :depth) 5))

(defn- last-move [game]
  (let [h (get game :history)]
    (when (not (empty? h)) (last h))))

(defn- show-board [game]
  (r/clear-screen)
  (println "=== Connect 4 ===")
  (when ai-player
    (println (str "AI plays as " (r/display-name ai-player)
                  " | difficulty: " (get difficulty :name)
                  " (depth " ai-depth ")")))
  (println)
  (print (r/render-last-move (last-move game)))
  (println (r/render-board (get game :board))))

(defn- show-end [game]
  (show-board game)
  (println)
  (case (get game :status)
    :won  (println (str (r/display-name (get game :winner)) " wins!"))
    :draw (println "Draw!")
    (println "Game aborted.")))

(defn- ai-turn [game]
  (show-board game)
  (let [p (get game :player)]
    (print (str (r/display-name p) " (AI) thinking..."))
    (php/flush)
    (let [start   (php/microtime true)
          col     (ai/best-move (get game :board) p ai-depth)
          elapsed (- (php/microtime true) start)]
      (println (str " column " (+ col 1) "  (" (php/number_format elapsed 2) "s)"))
      (g/step game col))))

(defn- parse-input [input]
  (cond
    (or (nil? input) (= input "q") (= input "quit")) :quit
    (= input "u")                                    :undo
    :else
    (let [n (php/intval input)]
      (if (and (>= n 1) (<= n b/cols))
        (- n 1)
        :invalid))))

(defn- human-turn [game]
  (show-board game)
  (print (str (r/display-name (get game :player))
              " > column (1-" b/cols ", u=undo, q=quit): "))
  (php/flush)
  (let [action (parse-input (read-input))]
    (cond
      (= action :quit)    :quit
      (= action :undo)    (g/undo game)
      (= action :invalid) game
      :else               (g/step game action))))

(defn play []
  (loop [game (g/make-game)]
    (cond
      (g/game-over? game)              (show-end game)
      (= (get game :player) ai-player) (recur (ai-turn game))
      :else
      (let [next (human-turn game)]
        (if (= next :quit)
          (show-end (put game :status :aborted))
          (recur next))))))

(when-not *build-mode*
  (play))
