(ns app\main
  (:require app\board :as b)
  (:require app\game :as g)
  (:require app\render :as r)
  (:require app\ai :as ai))

(def stdin (php/fopen "php://stdin" "r"))

(def ai-depth
  (let [env (php/getenv "AI_DEPTH")]
    (if (= false env) 3 (php/intval env))))

(def ai-player
  (case (php/getenv "AI")
    "red"    :red
    "yellow" :yellow
    false    nil
    nil))

(defn- read-input []
  (let [line (php/fgets stdin)]
    (if (= false line)
      nil
      (php/trim line))))

(defn- show-board [game]
  (r/clear-screen)
  (println "=== Connect 4 ===")
  (when ai-player
    (println (str "AI plays as " (r/display-name ai-player) ", depth " ai-depth)))
  (println)
  (println (r/render-board (get game :board))))

(defn- show-end [game]
  (show-board game)
  (println)
  (case (get game :status)
    :won  (println (str (r/display-name (get game :winner)) " wins!"))
    :draw (println "Draw!")
    (println "Game aborted.")))

(defn- ai-turn [game]
  (let [col (ai/best-move (get game :board) (get game :player) ai-depth)]
    (show-board game)
    (println (str (r/display-name (get game :player)) " (AI) plays column " (+ col 1)))
    (g/step game col)))

(defn- human-turn [game]
  (show-board game)
  (print (str (r/display-name (get game :player))
              " > column (1-" b/cols ", u=undo, q=quit): "))
  (let [input (read-input)]
    (cond
      (or (nil? input) (= input "q") (= input "quit")) :quit
      (= input "u") (g/undo game)
      :else
      (let [n (php/intval input)]
        (if (or (< n 1) (> n b/cols))
          game
          (g/step game (- n 1)))))))

(defn play []
  (loop [game (g/make-game)]
    (cond
      (g/game-over? game) (show-end game)
      (= (get game :player) ai-player) (recur (ai-turn game))
      :else
      (let [next (human-turn game)]
        (if (= next :quit)
          (show-end (put game :status :aborted))
          (recur next))))))

(play)
